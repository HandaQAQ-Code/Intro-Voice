<Window
    x:Class="MixerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MixerUI"
    xmlns:controls="using:MixerUI.Controls"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="RootLayout" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          Loaded="RootLayout_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：整条作为可拖拽标题区，右侧留给系统窗口按钮 -->
        <Border x:Name="AppTitleBar" Grid.Row="0" Padding="16,8,150,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="AppDragRegion" Background="Transparent" VerticalAlignment="Stretch"
                      MinWidth="220">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Image Source="ms-appx:///Assets/app-icon.png" Width="30" Height="30" />
                        <StackPanel Spacing="0" VerticalAlignment="Center">
                            <TextBlock Text="Intro Voice" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="音拓 · 直播调音台" FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <Border Style="{StaticResource PillBorder}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Gray" />
                            <TextBlock x:Name="ServiceText" Text="正在连接调音台服务…" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PillBorder}">
                        <TextBlock x:Name="EnginePillText" Text="引擎 · 已停止" FontSize="12" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="BusyRing" Width="18" Height="18" IsActive="False" />
                    <Button x:Name="MuteButton" Content="静音" Click="Mute_Click" IsEnabled="False" />
                    <Button x:Name="StartButton" Content="启动链路" Style="{StaticResource AccentButtonStyle}"
                            Click="Start_Click" IsEnabled="False" />
                    <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView x:Name="Nav" Grid.Row="1"
                        PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="True" AlwaysShowHeader="False"
                        OpenPaneLength="208" CompactPaneLength="52"
                        SelectionChanged="Nav_SelectionChanged">

            <NavigationView.PaneHeader>
                <TextBlock Text="工作区" FontSize="11" Margin="12,14,0,6"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="主控" Tag="live" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="内置效果" Tag="fx">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="创意工坊" Tag="workshop">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="麦克风配置" Tag="mic">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE720;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="plugins">
                    <NavigationViewItem.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="VST3 插件" />
                            <InfoBadge x:Name="PluginBadge" Value="0" Visibility="Collapsed" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="插件市场" Tag="market">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="帮助与更新" Tag="help">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <TextBlock Text="Intro Voice 1.0.0" FontSize="11" Margin="6,0,0,8"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </NavigationView.PaneFooter>

            <Grid x:Name="PagesRoot">
            <!-- 主控 -->
            <Grid x:Name="PageLive">
                <Grid Padding="18,14,18,18" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Height="196" CornerRadius="14">
                        <Grid>
                            <Image Source="ms-appx:///Assets/hero.png" Stretch="UniformToFill" />
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#F2000000" Offset="0" />
                                        <GradientStop Color="#B3000000" Offset="0.42" />
                                        <GradientStop Color="#00000000" Offset="0.88" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Padding="28,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="8">
                                    <TextBlock Text="INTRO VOICE · 音拓" Style="{StaticResource HeroEyebrow}" />
                                    <TextBlock Text="让每一次开口，都像在录音棚"
                                               FontSize="30" FontWeight="Bold" Foreground="White"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="AI 声纹提取 · 实时降噪 · 超分重建 · 内置效果与 VST3 · 一键送进 OBS"
                                               Style="{StaticResource HeroCaption}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                        <Border CornerRadius="11" Padding="10,3" Background="#26FFFFFF"
                                                BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <TextBlock Text="麦克风" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="→" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Border CornerRadius="11" Padding="10,3" Background="#26FFFFFF"
                                                BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <TextBlock Text="AI 人声" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="→" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Border CornerRadius="11" Padding="10,3" Background="#26FFFFFF"
                                                BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <TextBlock Text="内置效果" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="→" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Border CornerRadius="11" Padding="10,3" Background="#26FFFFFF"
                                                BorderBrush="#33FFFFFF" BorderThickness="1">
                                            <TextBlock Text="VST3" FontSize="11" Foreground="White" />
                                        </Border>
                                        <TextBlock Text="→" Foreground="#99FFFFFF" VerticalAlignment="Center" />
                                        <Border CornerRadius="11" Padding="10,3" Background="#F2C08A2E">
                                            <TextBlock Text="CABLE → OBS" FontSize="11" Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                    <Border CornerRadius="10" Padding="10,4" Background="#33FFFFFF"
                                            BorderBrush="#44FFFFFF" BorderThickness="1" HorizontalAlignment="Right">
                                        <TextBlock Text="v1.0.0" FontSize="11" Foreground="White" />
                                    </Border>
                                    <TextBlock Text="48 kHz · 立体声" FontSize="11" Foreground="#B3FFFFFF"
                                               HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <InfoBar x:Name="ErrorBar" Severity="Error" Title="音频链路错误" IsOpen="False"
                                     IsClosable="True" Closed="ErrorBar_Closed" />

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="输入 / 输出" Style="{StaticResource SectionTitle}" />
                                    <ComboBox x:Name="InputCombo" Header="物理麦克风" HorizontalAlignment="Stretch" />
                                    <ComboBox x:Name="OutputCombo" Header="输出（CABLE Input）" HorizontalAlignment="Stretch" />
                                    <Button Content="刷新设备列表" HorizontalAlignment="Stretch" Click="RefreshDevices_Click" />
                                    <TextBlock x:Name="RoutingText" Style="{StaticResource HintText}"
                                               Text="输入取自物理麦克风；输出写入 VB-CABLE 的 CABLE Input，OBS 从 CABLE Output 采集。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="AI 人声处理" Style="{StaticResource SectionTitle}" />
                                    <ComboBox x:Name="AiModeCombo" Header="模式" HorizontalAlignment="Stretch"
                                              SelectionChanged="AiMode_Changed" />
                                    <TextBlock x:Name="AiModeHint" Style="{StaticResource HintText}" />
                                    <ToggleSwitch x:Name="DenoiseSwitch" Header="实时降噪" />
                                    <TextBlock Text="输入增益（dB）" Style="{StaticResource HintText}" />
                                    <Slider x:Name="GainSlider" Minimum="-24" Maximum="24" StepFrequency="0.5"
                                            ValueChanged="LiveOption_Changed" />
                                    <TextBlock x:Name="GainValue" Text="0.0 dB" Style="{StaticResource HintText}" />
                                    <TextBlock Text="降噪底噪门限（dB）" Style="{StaticResource HintText}" />
                                    <Slider x:Name="FloorSlider" StepFrequency="1"
                                            ValueChanged="LiveOption_Changed" />
                                    <TextBlock x:Name="FloorValue" Text="-55 dB" Style="{StaticResource HintText}" />
                                    <TextBlock Text="超分强度" Style="{StaticResource HintText}" />
                                    <Slider x:Name="SrSlider" Minimum="0" Maximum="1" StepFrequency="0.05"
                                            ValueChanged="LiveOption_Changed" />
                                    <TextBlock x:Name="SrValue" Text="0.70" Style="{StaticResource HintText}" />
                                    <ComboBox x:Name="LatencyCombo" Header="超分延迟模式" HorizontalAlignment="Stretch"
                                              SelectionChanged="Latency_Changed" />
                                    <TextBlock x:Name="LatencyHint" Style="{StaticResource HintText}" />
                                    <TextBlock Text="AI 关闭时为 48 kHz 全带宽旁通，不会先降采样到 16 kHz。AI 需要 data/target.wav 中的声纹。"
                                               Style="{StaticResource HintText}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="实时频谱" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Grid.Column="1" Text="40 Hz – 16 kHz · 32 段" Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <controls:SpectrumView x:Name="Spectrum" Height="92" />
                                    <TextBlock x:Name="SpectrumHint" Style="{StaticResource HintText}"
                                               Text="链路启动后显示处理后的频谱；停止时为静止。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="实时电平" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="RateText" Grid.Column="1" Text="—"
                                                   Style="{StaticResource HintText}" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="输入 · 麦克风" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="InputDbText" Grid.Column="1" Text="—"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <ProgressBar x:Name="InputMeter" Maximum="1" Height="10" CornerRadius="5" />
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="输出 · CABLE Input" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="OutputDbText" Grid.Column="1" Text="—"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <ProgressBar x:Name="OutputMeter" Maximum="1" Height="10" CornerRadius="5" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="运行状态" Style="{StaticResource SectionTitle}" />
                                        <Grid ColumnSpacing="10" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="状态" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="RunStateText" Grid.Column="1" Text="未运行" />
                                            <TextBlock Grid.Row="1" Text="AI 后端" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="BackendText" Grid.Row="1" Grid.Column="1" Text="—"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Text="插件延迟" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="LatencyText" Grid.Row="2" Grid.Column="1" Text="—" />
                                            <TextBlock Grid.Row="3" Text="RTF" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="RtfText" Grid.Row="3" Grid.Column="1" Text="—" />
                                            <TextBlock Grid.Row="4" Text="丢块 / 欠载" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="DropsText" Grid.Row="4" Grid.Column="1" Text="—" />
                                            <TextBlock Grid.Row="5" Text="FIFO 裁剪" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="TrimText" Grid.Row="5" Grid.Column="1" Text="—" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="电脑性能" Style="{StaticResource SectionTitle}" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" />
                                            <ProgressBar x:Name="CpuBar" Grid.Column="1" Maximum="100" Height="8"
                                                         VerticalAlignment="Center" />
                                            <TextBlock x:Name="CpuText" Grid.Column="2" Text="—" MinWidth="46"
                                                       TextAlignment="Right" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                                            <ProgressBar x:Name="GpuBar" Grid.Column="1" Maximum="100" Height="8"
                                                         VerticalAlignment="Center" />
                                            <TextBlock x:Name="GpuText" Grid.Column="2" Text="—" MinWidth="46"
                                                       TextAlignment="Right" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="内存" Style="{StaticResource MetricLabel}" />
                                            <ProgressBar x:Name="RamBar" Grid.Column="1" Maximum="100" Height="8"
                                                         VerticalAlignment="Center" />
                                            <TextBlock x:Name="RamText" Grid.Column="2" Text="—" MinWidth="46"
                                                       TextAlignment="Right" Style="{StaticResource ValueText}" />
                                        </Grid>
                                        <TextBlock x:Name="SystemDetailText" Style="{StaticResource HintText}" Text="采样中…" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="引擎消息" Style="{StaticResource SectionTitle}" />
                                    <ListView x:Name="MessageList" Height="160" SelectionMode="None"
                                              IsItemClickEnabled="False" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 内置效果 -->
            <Grid x:Name="PageFx" Visibility="Collapsed" Padding="18,14,18,14" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 预设栏：常驻页面顶部，调参与存档在同一屏 -->
                <Border Style="{StaticResource CardStyle}" Padding="14,10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="228" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE74E;" FontSize="15"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="预设" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource PillBorder}" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PresetCountText" Text="0 套" FontSize="11" />
                                </Border>
                            </StackPanel>

                            <ComboBox x:Name="PresetCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                                      PlaceholderText="（还没有预设）"
                                      SelectionChanged="PresetCombo_SelectionChanged" />

                            <TextBlock x:Name="PresetDetailText" Grid.Column="2" Style="{StaticResource HintText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="保存当前的全部设置后，可在这里一键切换场景。" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button x:Name="PresetLoadButton" Content="载入" Click="PresetLoad_Click"
                                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                                <Button x:Name="PresetSaveButton" Content="覆盖保存" Click="PresetSave_Click"
                                        IsEnabled="False" />
                                <Button Content="另存为" Click="PresetSaveAs_Click" />
                                <Button x:Name="PresetDeleteButton" Content="删除" Click="PresetDelete_Click"
                                        IsEnabled="False" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Style="{StaticResource HintText}"
                                   Text="预设包含插件链顺序与参数、AI 档位与降噪、内置效果器参数、创意工坊插件；载入前请先停止处理。" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Padding="0,0,4,0">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="内置效果器" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="DspStatusText" Style="{StaticResource HintText}"
                                               Text="全部在音频线程内实时运算，零额外延迟，参数随预设保存。" />
                                    <TextBlock Text="高通 → 低通 → 噪声门 → 压缩 → 三段 EQ → VST3 链 → 限幅"
                                               Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Button Content="恢复默认" Click="ResetDsp_Click" />
                                    <ToggleSwitch x:Name="DspMasterSwitch" MinWidth="0" Header="总开关"
                                                  OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 左列：滤波 + 压缩 -->
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="滤波" Style="{StaticResource SectionTitle}" />
                                        <Border Style="{StaticResource InnerCardStyle}">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="高通（切低频隆隆声）" Style="{StaticResource MetricLabel}" />
                                                    <ToggleSwitch Grid.Column="1" x:Name="HpfSwitch" MinWidth="0"
                                                                  OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                                </Grid>

                                        <TextBlock Text="人声建议：高通 80–120 Hz（男声偏低、女声偏高），低通保持 16 kHz 以上；24 dB/oct 更干净。" Style="{StaticResource HintText}" />
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="118" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="截止" Style="{StaticResource MetricLabel}" />
                                                    <Slider x:Name="HpfFreqSlider" Grid.Column="1" StepFrequency="5"
                                                            ValueChanged="Dsp_Changed" />
                                                    <TextBlock x:Name="HpfFreqText" Grid.Column="2" Text="80 Hz"
                                                               Style="{StaticResource ValueText}" TextAlignment="Right" />
                                                    <ComboBox x:Name="HpfSlopeCombo" Grid.Column="3" MinWidth="0"
                                                              SelectionChanged="DspSlope_Changed" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource InnerCardStyle}">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="低通（压高频毛刺）" Style="{StaticResource MetricLabel}" />
                                                    <ToggleSwitch Grid.Column="1" x:Name="LpfSwitch" MinWidth="0"
                                                                  OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                                </Grid>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="68" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="64" />
                                                        <ColumnDefinition Width="118" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="截止" Style="{StaticResource MetricLabel}" />
                                                    <Slider x:Name="LpfFreqSlider" Grid.Column="1" StepFrequency="250"
                                                            ValueChanged="Dsp_Changed" />
                                                    <TextBlock x:Name="LpfFreqText" Grid.Column="2" Text="16000 Hz"
                                                               Style="{StaticResource ValueText}" TextAlignment="Right" />
                                                    <ComboBox x:Name="LpfSlopeCombo" Grid.Column="3" MinWidth="0"
                                                              SelectionChanged="DspSlope_Changed" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="压缩器" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1" x:Name="CompSwitch" MinWidth="0"
                                                          OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                        </Grid>

                                        <TextBlock Text="人声建议：阈值 -20~-14 dB、3:1、启动 5–10 ms、释放 80–150 ms，压缩量 3–6 dB 最自然。" Style="{StaticResource HintText}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="阈值" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="CompThreshSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="CompThreshText" Grid.Column="2" Text="-18 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="压缩比" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="CompRatioSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="CompRatioText" Grid.Column="2" Text="3.0 : 1"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="启动" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="CompAttackSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="CompAttackText" Grid.Column="2" Text="8 ms"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="释放" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="CompReleaseSlider" Grid.Column="1" StepFrequency="5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="CompReleaseText" Grid.Column="2" Text="120 ms"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="补偿" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="CompMakeupSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="CompMakeupText" Grid.Column="2" Text="0.0 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <TextBlock x:Name="CompGrText" Style="{StaticResource HintText}" Text="压缩量 —" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 右列：EQ + 门限 -->
                            <StackPanel Grid.Column="1" Spacing="12">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="三段 EQ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1" x:Name="EqSwitch" MinWidth="0"
                                                          OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                        </Grid>

                                        <TextBlock Text="人声建议：低频 +2~3 dB 增加厚度，1–3 kHz 提 1~2 dB 增清晰度，高频 +1~2 dB 添空气感；多用衰减少用提升。" Style="{StaticResource HintText}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="低频" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="EqLowSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="EqLowText" Grid.Column="2" Text="0.0 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="中频" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="EqMidSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="EqMidText" Grid.Column="2" Text="0.0 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="中心频率" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="EqMidFreqSlider" Grid.Column="1" StepFrequency="50"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="EqMidFreqText" Grid.Column="2" Text="1000 Hz"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Q" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="EqMidQSlider" Grid.Column="1" StepFrequency="0.1"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="EqMidQText" Grid.Column="2" Text="1.0"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="高频" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="EqHighSlider" Grid.Column="1" StepFrequency="0.5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="EqHighText" Grid.Column="2" Text="0.0 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="噪声门" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1" x:Name="GateSwitch" MinWidth="0"
                                                          OnContent="开" OffContent="关" Toggled="Dsp_Toggled" />
                                        </Grid>

                                        <TextBlock Text="人声建议：阈值 -50~-45 dB、保持 60–100 ms、释放 120–200 ms、衰减 -18 dB；过激会切掉尾音。" Style="{StaticResource HintText}" />
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="阈值" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="GateThreshSlider" Grid.Column="1" StepFrequency="1"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="GateThreshText" Grid.Column="2" Text="-50 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="保持" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="GateHoldSlider" Grid.Column="1" StepFrequency="5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="GateHoldText" Grid.Column="2" Text="80 ms"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="释放" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="GateReleaseSlider" Grid.Column="1" StepFrequency="5"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="GateReleaseText" Grid.Column="2" Text="150 ms"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="68" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="衰减" Style="{StaticResource MetricLabel}" />
                                            <Slider x:Name="GateRangeSlider" Grid.Column="1" StepFrequency="1"
                                                    ValueChanged="Dsp_Changed" />
                                            <TextBlock x:Name="GateRangeText" Grid.Column="2" Text="-18 dB"
                                                       Style="{StaticResource ValueText}" TextAlignment="Right" />
                                        </Grid>
                                        <TextBlock x:Name="GateStateText" Style="{StaticResource HintText}" Text="门状态 —" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 创意工坊 -->
            <Grid x:Name="PageWorkshop" Visibility="Collapsed" Padding="18,14,18,14" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="14,10">
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="15"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="创意工坊" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource PillBorder}" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="Python DSP" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="不会写代码也能做插件：挑一个模板，拖动两个滑块，保存就生效。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Content="接口文档" Click="WorkshopDocs_Click" />
                            <ComboBox x:Name="WorkshopTemplateCombo" Width="118" PlaceholderText="从模板开始"
                                      SelectionChanged="WorkshopTemplate_Changed" />
                            <Button Content="新建" Click="WorkshopNew_Click" />
                            <Button Content="保存并启用" Click="WorkshopSave_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="测试" Click="WorkshopTest_Click" />
                            <ToggleSwitch x:Name="WsEnableSwitch" OnContent="启用" OffContent="停用"
                                          IsOn="False" MinWidth="0" Toggled="WsEnable_Toggled" />
                            <Button x:Name="WorkshopPublishButton" Content="发布到市场" Click="WorkshopPublish_Click"
                                    IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch x:Name="WsModeSwitch" OffContent="新手模式" OnContent="进阶模式"
                                          MinWidth="0" Toggled="WsMode_Toggled" />
                            <TextBlock x:Name="WsModeHint" Style="{StaticResource HintText}" VerticalAlignment="Center"
                                       Text="新手模式只显示模板和参数；需要改代码时切到进阶。" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="272" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="我的插件" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="WorkshopCountText" Grid.Column="1" Text="0 个"
                                           Style="{StaticResource HintText}" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListView x:Name="WorkshopList" SelectionMode="Single"
                                          SelectionChanged="WorkshopList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:WorkshopItem">
                                            <Grid Padding="0,5" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <FontIcon Grid.Column="1" Glyph="&#xE73E;" FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Visibility="{x:Bind Enabled}"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="WorkshopEmpty" VerticalAlignment="Center" Spacing="6"
                                            HorizontalAlignment="Center" MaxWidth="230">
                                    <Image Source="ms-appx:///Assets/empty-plugins.png"
                                           Width="72" Height="72" Stretch="Uniform" />
                                    <TextBlock Text="还没有自己的插件" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="从右上角模板开始写，或到插件市场安装别人发布的作品。"
                                               Style="{StaticResource HintText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Spacing="8">
                                <Border Style="{StaticResource InnerCardStyle}" Padding="10,8">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="API 速查" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="x：(块, 2) float32" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="sr：采样率 48000" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="params：归一化后的参数字典" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="可用 np / db_to_gain / soft_clip" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="禁止 import、文件与网络访问" />
                                    </StackPanel>
                                </Border>
                                <Button Content="删除选中" Click="WorkshopDelete_Click"
                                        HorizontalAlignment="Stretch" />
                                <TextBlock x:Name="WorkshopPathText" Style="{StaticResource HintText}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="WsCodeRow" Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="WsBeginnerCard" Style="{StaticResource CardStyle}" Padding="14,12">
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="选一个模板开始" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="点卡片载入示例 → 点右上角「保存并启用」→ 在下方拖动滑块微调，改完立即生效。" />
                                </StackPanel>
                                <Grid ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Tag="1" Click="WsTemplateCard_Click" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="空气感" FontWeight="SemiBold" />
                                            <TextBlock Text="提亮高频，人声更通透" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1" Tag="3" Click="WsTemplateCard_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="立体声加宽" FontWeight="SemiBold" />
                                            <TextBlock Text="拉开左右声场" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Tag="2" Click="WsTemplateCard_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="温和饱和" FontWeight="SemiBold" />
                                            <TextBlock Text="加一点密度和温度" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="1" Tag="4" Click="WsTemplateCard_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="低频收紧" FontWeight="SemiBold" />
                                            <TextBlock Text="切掉喷麦与桌面震动" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="2" Tag="0" Click="WsTemplateCard_Click"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,8">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="空白模板" FontWeight="SemiBold" />
                                            <TextBlock Text="从最小骨架自己写" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="WsBeginnerHint" Style="{StaticResource HintText}"
                                           Text="不确定选哪个？先试「空气感」，对直播人声最稳。担心效果可以点「测试」先离线跑一遍。" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="WsMetaCard" Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,10">
                            <Grid ColumnSpacing="10" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="名称" Style="{StaticResource MetricLabel}" />
                                    <TextBox x:Name="WsNameBox" PlaceholderText="例如：空气感" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="标识（英文小写）" Style="{StaticResource MetricLabel}" />
                                    <TextBox x:Name="WsSlugBox" PlaceholderText="air-detail" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="作者" Style="{StaticResource MetricLabel}" />
                                    <TextBox x:Name="WsAuthorBox" PlaceholderText="你的名字" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Spacing="2">
                                    <TextBlock Text="版本 / 许可" Style="{StaticResource MetricLabel}" />
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WsVersionBox" Text="1.0.0" />
                                        <ComboBox x:Name="WsLicenseCombo" Grid.Column="1"
                                                  HorizontalAlignment="Stretch" />
                                    </Grid>
                                </StackPanel>
                                <TextBox x:Name="WsDescBox" Grid.Row="1" Grid.ColumnSpan="4"
                                         PlaceholderText="一句话说明它做什么、适合什么素材；会显示在插件市场里。" />
                            </Grid>
                        </Border>

                        <Border x:Name="WsCodeCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="效果代码" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="WsCodeStatus" Grid.Column="1" Style="{StaticResource HintText}"
                                               VerticalAlignment="Center" Text="未保存" />
                                </Grid>
                                <TextBox x:Name="WsCodeBox" Grid.Row="1"
                                         FontFamily="{StaticResource CodeFontFamily}" FontSize="13"
                                         Padding="10,16" VerticalContentAlignment="Top"
                                         AcceptsReturn="True" TextWrapping="NoWrap" IsSpellCheckEnabled="False"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         TextChanged="WsCode_TextChanged"
                                         PlaceholderText="def process(x, sr, params):&#x0a;    return x" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,10">
                            <Grid RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="参数（脚本里的 PARAMS）" Style="{StaticResource SectionTitle}" />
                                <ItemsControl x:Name="WorkshopParamList" Grid.Row="1">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:WorkshopParam">
                                            <Grid ColumnSpacing="10" Padding="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="96" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="76" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource MetricLabel}" />
                                                <Slider Grid.Column="1" Minimum="{x:Bind Min}" Maximum="{x:Bind Max}"
                                                        StepFrequency="{x:Bind Step}"
                                                        Value="{x:Bind Value, Mode=OneWay}"
                                                        ValueChanged="WorkshopParam_Changed" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Display, Mode=OneWay}"
                                                           Style="{StaticResource ValueText}" TextAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" x:Name="WorkshopTestText" Style="{StaticResource HintText}"
                                           Text="点「测试」用 1 秒合成信号离线跑一遍，检查输出电平、峰值与每块耗时。" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- VST3 插件 -->
<Grid x:Name="PagePlugins" Visibility="Collapsed">
                <Grid Padding="18,14,18,18" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="PluginChainCard" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="插件链" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="ChainCountText" Text="0 个插件" Style="{StaticResource HintText}" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="AddPluginButton" Content="扫描 / 添加"
                                        Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>

                            <Grid Grid.Row="1">
                                <ListView x:Name="ChainList" SelectionMode="Single"
                                          SelectionChanged="ChainList_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:PluginItem">
                                            <StackPanel Padding="0,5">
                                                <TextBlock Text="{x:Bind Header}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="ChainEmpty" VerticalAlignment="Center" Spacing="6"
                                            HorizontalAlignment="Center" MaxWidth="300">
                                    <Image Source="ms-appx:///Assets/empty-plugins.png"
                                           Style="{StaticResource EmptyStateImage}" />
                                    <TextBlock Text="还没有加载插件" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="点击右上角「扫描 / 添加」，从系统 VST3 目录选择效果器加到链上。"
                                               Style="{StaticResource HintText}" TextAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                                <Button x:Name="EditorButton" Content="打开面板" Click="Editor_Click" IsEnabled="False" />
                                <Button x:Name="BypassButton" Content="旁通" Click="Bypass_Click" IsEnabled="False" />
                                <Button x:Name="UpButton" Content="上移" Click="Up_Click" IsEnabled="False" />
                                <Button x:Name="DownButton" Content="下移" Click="Down_Click" IsEnabled="False" />
                                <Button x:Name="RemoveButton" Content="移除" Click="Remove_Click" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Style="{StaticResource HintText}"
                                       Text="音频由服务进程内的原生 VST3 宿主原地处理；插件面板是真实原生窗口。" />
                        </Grid>
                    </Border>

                    <Border x:Name="PluginParamsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ParamsTitle" Text="插件参数" Style="{StaticResource SectionTitle}" />
                            <Grid Grid.Row="1">
                                <ListView x:Name="ParamList" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:VstParamItem">
                                            <Grid Padding="0,3" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="180" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Slider Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.001"
                                                        Value="{x:Bind Value, Mode=OneWay}"
                                                        ValueChanged="ParamSlider_ValueChanged" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="ParamEmpty" VerticalAlignment="Center" Spacing="6"
                                            HorizontalAlignment="Center" MaxWidth="320">
                                    <TextBlock Text="选中左侧插件后，这里会列出它的全部参数" Style="{StaticResource HintText}"
                                               TextAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 手机麦克风 -->
            <!-- 麦克风配置：电脑声卡为默认来源，手机麦克风是同一页里的无线派生来源 -->
            <Grid x:Name="PageMicConfig" Visibility="Collapsed" Padding="18,14,18,18" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}" Padding="16,12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE720;" FontSize="16"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="麦克风配置" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource PillBorder}" Padding="8,1" VerticalAlignment="Center">
                                    <TextBlock Text="输入源" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="先决定声音从哪进来，再看这一路的电平与处理。电脑声卡即插即用；手机麦克风是它的无线扩展，走局域网直连。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ToggleButton x:Name="MicSrcDeviceToggle" Click="MicSourceToggle_Click"
                                          MinWidth="158" Padding="12,8" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7F5;" FontSize="13" />
                                        <TextBlock Text="电脑声卡" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="USB / XLR 麦克风" FontSize="11" Opacity="0.72" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="MicSrcMobileToggle" Click="MicSourceToggle_Click"
                                          MinWidth="158" Padding="12,8" HorizontalContentAlignment="Left">
                                <StackPanel Spacing="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B8;" FontSize="13" />
                                        <TextBlock Text="手机麦克风" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="Wi-Fi 无线接入" FontSize="11" Opacity="0.72" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <!-- ========== A. 手机麦克风（无线扩展） ========== -->
                    <Grid x:Name="MicMobileView" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="356" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border x:Name="MicStateDot" Width="9" Height="9" CornerRadius="4.5"
                                                Background="#8A8078" VerticalAlignment="Center" />
                                        <TextBlock Text="无线配对" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="MicStateText" Text="未启动" Style="{StaticResource HintText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="手机采集、Wi-Fi 直传，电脑端做增益 / 高通 / 噪声门，再进入效果器链路。音频只在局域网内传输，不经过任何服务器。" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="MicToggleButton" Content="启动服务"
                                                Style="{StaticResource AccentButtonStyle}" Click="MicToggle_Click" />
                                        <Button Content="复制连接信息" Click="MicCopy_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="打开安装页" Click="MicInstallPage_Click" />
                                        <Button Content="定位安装包" Click="MicApk_Click" />
                                    </StackPanel>

                                    <Border Style="{StaticResource InnerCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="电脑地址" Style="{StaticResource MetricLabel}" />
                                            <TextBlock x:Name="MicEndpointText" Text="服务未启动"
                                                       FontFamily="{StaticResource CodeFontFamily}" FontSize="15" />
                                            <TextBlock Text="连接 PIN" Style="{StaticResource MetricLabel}" Margin="0,8,0,0" />
                                            <TextBlock x:Name="MicPinText" Text="——" FontFamily="{StaticResource CodeFontFamily}"
                                                       FontSize="26" FontWeight="SemiBold" CharacterSpacing="140"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </Border>

                                    <Grid x:Name="MicQrRow" ColumnSpacing="10" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <Border x:Name="MicConnectQrBox" Background="White" CornerRadius="10" Padding="6">
                                                <Image x:Name="MicConnectQr" Height="148" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="扫码连接手机" Style="{StaticResource HintText}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <Border x:Name="MicInstallQrBox" Background="White" CornerRadius="10" Padding="6">
                                                <Image x:Name="MicInstallQr" Height="148" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="扫码安装 App" Style="{StaticResource HintText}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="MicQrHint" Style="{StaticResource HintText}"
                                               Text="手机与电脑连同一个 Wi-Fi，用系统相机或微信扫码；已装 App 会自动带出地址与 PIN。" />
                                    <Border Style="{StaticResource InnerCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="手机端还能调" Style="{StaticResource MetricLabel}" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="采样率、帧长、采集源，系统降噪 / 回声消除，以及手机本地增益；锁屏后由前台服务继续推流。" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="连接状态" Style="{StaticResource SectionTitle}" />
                                        <Grid RowSpacing="10" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="MicClientsText" Text="0" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="已连接设备" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="MicRateText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="手机采样率" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="MicLevelText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="输入电平" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1">
                                                <TextBlock x:Name="MicBufferText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="缓冲" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1">
                                                <TextBlock x:Name="MicPacketsText" Text="0" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="接收包数" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2">
                                                <TextBlock x:Name="MicDropText" Text="0" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="丢包 / 溢出" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar x:Name="MicLevelBar" Height="6" Maximum="100" Value="0" />
                                        <TextBlock x:Name="MicDeviceText" Style="{StaticResource HintText}"
                                                   Text="等待手机连接…" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="这一路的处理" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="只作用于手机送来的音频，改完立即生效；手机 App 里也能调同一组参数。声卡输入的增益与降噪在主控页。" />

                                        <Grid ColumnSpacing="10" Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="输入增益" VerticalAlignment="Center" />
                                            <Slider x:Name="MicGainSlider" Grid.Column="1" ValueChanged="MicSlider_Changed" />
                                            <TextBlock x:Name="MicGainValue" Grid.Column="2" HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="高通" VerticalAlignment="Center" />
                                            <Slider x:Name="MicHpfSlider" Grid.Column="1" ValueChanged="MicSlider_Changed" />
                                            <TextBlock x:Name="MicHpfValue" Grid.Column="2" HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="噪声门" VerticalAlignment="Center" />
                                            <Slider x:Name="MicGateSlider" Grid.Column="1" ValueChanged="MicSlider_Changed" />
                                            <TextBlock x:Name="MicGateValue" Grid.Column="2" HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>

                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="66" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="抖动缓冲" VerticalAlignment="Center" />
                                            <Slider x:Name="MicJitterSlider" Grid.Column="1" ValueChanged="MicSlider_Changed" />
                                            <TextBlock x:Name="MicJitterValue" Grid.Column="2" HorizontalAlignment="Right"
                                                       Style="{StaticResource ValueText}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="三步上手" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="1. 点「启动服务」，记下电脑地址与 PIN。" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="2. 手机上安装 Intro Voice Mic，扫码或手填地址和 PIN，点连接。" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="3. 到「主控」页点开始；手机锁屏也能继续推流。" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ========== B. 电脑声卡（默认来源） ========== -->
                    <Grid x:Name="MicDeviceView" ColumnSpacing="14" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="356" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="12">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="当前输入设备" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="MicDeviceNameText" Text="未选择"
                                               Style="{StaticResource ValueText}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="设备列表在这里只做展示，选择与刷新在主控页，避免两处状态打架。" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="去主控页选择设备" Click="MicGoLive_Click"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button Content="刷新设备列表" Click="MicRefreshDevices_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="声卡这一路的调节" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="输入增益、降噪门限、超分强度与延迟模式，都在主控页「AI 人声处理」里；内置效果与 VST3 在各自页面。" />
                                    <TextBlock x:Name="MicDeviceRunText" Style="{StaticResource HintText}"
                                               Text="链路未运行。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="挑设备的三条经验" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="· 优先选带 USB / Microphone 的条目，别选「立体声混音」，会重复录到系统声。" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="· 动圈麦常要 +10 dB 以上增益；电容麦一般 0 dB 就够。" />
                                    <TextBlock Style="{StaticResource HintText}"
                                               Text="· 换设备后回主控页重新开始，采样率会重新协商。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="当前输入电平" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="MicCfgLevelText" Text="—" Style="{StaticResource ValueText}" />
                                        <ProgressBar x:Name="MicCfgLevelBar" Height="6" Maximum="100" Value="0" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="目标 -12 ~ -6 dB：太低就加输入增益，经常冲到 0 就减一点。" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="信号路径" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="声卡输入的音频依次经过下面几段，每一段都可以单独旁通。" />
                                        <Grid ColumnSpacing="6" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border Style="{StaticResource PillBorder}" Padding="10,3">
                                                <TextBlock Text="物理麦克风" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="→" Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                                       Text="USB 麦克风或声卡输入，格式自动协商" VerticalAlignment="Center" />
                                            <Border Grid.Row="1" Style="{StaticResource PillBorder}" Padding="10,3">
                                                <TextBlock Text="AI 人声" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="→" Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource HintText}"
                                                       Text="降噪与超分，关闭时 48 kHz 全带宽旁通" VerticalAlignment="Center" />
                                            <Border Grid.Row="2" Style="{StaticResource PillBorder}" Padding="10,3">
                                                <TextBlock Text="内置效果" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="→" Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource HintText}"
                                                       Text="EQ、压缩、混响与创意工坊插件" VerticalAlignment="Center" />
                                            <Border Grid.Row="3" Style="{StaticResource PillBorder}" Padding="10,3">
                                                <TextBlock Text="VST3" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="→" Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource HintText}"
                                                       Text="第三方插件链，可随时旁通" VerticalAlignment="Center" />
                                            <Border Grid.Row="4" Style="{StaticResource PillBorder}" Padding="10,3">
                                                <TextBlock Text="CABLE → OBS" FontSize="12" />
                                            </Border>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="→" Style="{StaticResource HintText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource HintText}"
                                                       Text="写入虚拟声卡，OBS 从 CABLE Output 采集" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="链路自检" Style="{StaticResource SectionTitle}" />
                                        <Grid ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="MicCfgInRateText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="输入采样率" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="MicCfgOutRateText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="输出采样率" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="MicCfgLatencyText" Text="—" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="链路延迟" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock x:Name="MicCfgDropsText" Text="0" Style="{StaticResource ValueText}" />
                                                <TextBlock Text="掉块" Style="{StaticResource MetricLabel}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="MicCfgHealthText" Style="{StaticResource HintText}"
                                                   Text="引擎未运行；开始后这里显示实际采样率与延迟。" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="手机也能当麦克风" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Style="{StaticResource HintText}"
                                                       Text="没有声卡或想离开桌面走动时，把手机接进来：同一页切到「手机麦克风」，扫码配对即可，处理链路完全一样。" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="切换到手机麦克风" Click="MicGoMobile_Click"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 插件市场 -->
            <Grid x:Name="PageMarket" Visibility="Collapsed" Padding="18,14,18,18" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="插件市场" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="MarketStatusText" Style="{StaticResource HintText}"
                                       Text="从远程目录拉取可用的 VST3 效果器；一键安装到当前用户目录，不需要管理员权限。" />
                            <TextBlock x:Name="MarketSourceText" Style="{StaticResource HintText}" />
                            <ProgressBar x:Name="MarketProgress" Height="4" Maximum="100" Visibility="Collapsed"
                                         Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="刷新目录" Click="MarketRefresh_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <ListView x:Name="MarketList" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:MarketItem">
                                    <Grid Padding="0,10" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <Border Style="{StaticResource PillBorder}" Padding="8,1">
                                                    <TextBlock Text="{x:Bind Badge}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource HintText}" />
                                            <TextBlock Text="{x:Bind Summary}" Style="{StaticResource HintText}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Bind ActionText}" Tag="{x:Bind Slug}"
                                                VerticalAlignment="Center" Click="MarketAction_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="MarketEmpty" VerticalAlignment="Center" Spacing="6"
                                    HorizontalAlignment="Center" MaxWidth="360" Visibility="Collapsed">
                            <Image Source="ms-appx:///Assets/empty-plugins.png"
                                   Style="{StaticResource EmptyStateImage}" />
                            <TextBlock Text="目录还没有内容" HorizontalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="点「刷新目录」从远程拉取；离线时会显示上次缓存。"
                                       Style="{StaticResource HintText}" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 帮助 -->
            <Grid x:Name="PageHelp" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="18,14,18,18" Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="三档效果对比" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="TierCompare" Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="OBS 采集设置" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="本程序不修改系统默认播放/录制设备，也不改动 OBS 配置。所有处理结果写入 VB-CABLE 的 CABLE Input。" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="OBS 侧在「音频输出采集」或「应用程序音频采集」中选择 CABLE Output（VB-Audio Virtual Cable）；也可以添加「音频输入采集」并选择 CABLE Output。" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="如果 OBS 里没有声音，先确认顶栏状态为「运行中」，再看「主控」页的输出电平是否有跳动。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="声纹与模型" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="AI 档需要 data/target.wav 中的声纹。想换声纹时，运行 tools\录制声纹.bat 重新采集（16 kHz、单声道、至少 3 秒有效人声）。" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="GPU 档需要额外安装 CUDA 版 PyTorch：运行 tools\install_gpu_support.bat，装完重启程序即可在「主控」页选择 GPU 档。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="故障排查" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="服务未连接：查看 data\mixer\service.log；界面日志在 data\mixer\ui.log。" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="没有声音：确认输出设备为 CABLE Input、系统未静音本程序、OBS 采集的是 CABLE Output。" />
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="声音断续：RTF 接近 1 时说明 CPU 跟不上，可关闭超分或改用 GPU 档。" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Intro Voice 音拓 1.0.0" Style="{StaticResource HintText}" />
                                <TextBlock Text="WinUI 3 界面 + Python 音频引擎 + 原生 VST3 宿主；内置效果器为 numpy/scipy 实时实现。"
                                           Style="{StaticResource HintText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE895;" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}"
                                           Text="从 GitHub Releases 检查新版本；下载后校验 SHA-256，关闭程序时自动替换，失败回滚。" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="检查更新" Click="UpdateCheck_Click"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button x:Name="UpdateInstallButton" Content="下载并安装"
                                            Click="UpdateInstall_Click" IsEnabled="False" />
                                    <Button Content="打开发布页" Click="UpdatePage_Click" />
                                </StackPanel>
                                <ProgressBar x:Name="UpdateProgress" Height="4" Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource HintText}"
                                           Text="当前版本 1.0.0" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
            </Grid>
        </NavigationView>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="18,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="IN" Style="{StaticResource MetricLabel}" />
                    <ProgressBar x:Name="BarInputMeter" Width="90" Maximum="1" Height="6" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarInputText" Text="—" Style="{StaticResource ValueText}" MinWidth="62" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="OUT" Style="{StaticResource MetricLabel}" />
                    <ProgressBar x:Name="BarOutputMeter" Width="90" Maximum="1" Height="6" VerticalAlignment="Center" />
                    <TextBlock x:Name="BarOutputText" Text="—" Style="{StaticResource ValueText}" MinWidth="62" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="CPU" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="BarCpuText" Text="—" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="GPU" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="BarGpuText" Text="—" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="RTF" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="BarRtfText" Text="—" Style="{StaticResource ValueText}" />
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="丢块" Style="{StaticResource MetricLabel}" />
                    <TextBlock x:Name="BarDropsText" Text="—" Style="{StaticResource ValueText}" />
                </StackPanel>
                <TextBlock Grid.Column="7" Text="v1.0.0" Style="{StaticResource MetricLabel}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
